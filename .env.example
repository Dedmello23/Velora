# Copy this file to .env.local and fill in your values.
# Never commit .env.local to GitHub.

# Groq API -> Get API key (console.groq.com)
GROQ_API_KEY=

# Groq model name (e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Supabase -> Project Settings -> Project URL
SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> secret key (service_role)
# Server only. Never use this in frontend code.
SUPABASE_SECRET_KEY=

# Your team's passcode. It protects your app and your quota.
APP_PASSCODE=
